{
  "name": "expense-tracker-web",
  "version": "1.0.0",
  "description": "expense tracking web application",
  "author": "sarvesh",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node -r dotenv/config --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "jest":{
    "testMatch":[
      "**/src/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
